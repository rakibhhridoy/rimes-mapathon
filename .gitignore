# Caches and build artefacts
cache/
data/cache/
__pycache__/
*.pyc
*.egg-info/
dist/
build/

# Data — too large for git; archived on Zenodo (see README).
# Covers the base region (data/raw ...), each region (data/sylhet/raw ...)
# and the cross-region cache of national downloads (data/shared).
data/raw/
data/processed/
data/output/
data/cache/
data/*/raw/
data/raw_s1a/
data/*/raw_s1a/
data/*/processed/
data/*/output/
data/*/cache/
data/pooled/
data/shared/
data.zip
/tmp/

