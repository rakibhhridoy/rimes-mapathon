*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Local environment
.env
.zenodo_token
.venv/
venv/

# OS and editors
.DS_Store
._*
.vscode/
.idea/
dist/
docs/figures/chain_d3/node_modules/

# Superseded version-1 diagrams, kept on disk but not in the repo
docs/archive_v1/legacy_figures/

# Built artefacts of the web application: rebuild with scripts/build_web.py
web/data/

# Full texts for the literature check; most may not be redistributed.
docs/litreview/pdfs/

# Submission package: PNGs and intermediate Markdown are rebuilt by
# docs/paper/build_submission.py
docs/paper/submission/figures/*.png
docs/paper/submission/*.md
data/backup_*/
web/apps.conf

# Downloaded source PDFs for checking citations (publisher copyright)
docs/paper/sources/

# Copyrighted reference PDFs, kept locally only
docs/paper/refs/
docs/paper/submission/upload/

# SoftwareX round-1 revision: reviews and response are confidential, kept local.
# Only the frozen baseline is tracked.
docs/softwarex/revision/*
!docs/softwarex/revision/baseline/
docs/softwarex/SOFTX-D-26-01375-reviews.zip
docs/softwarex/SOFTX-S-26-01946.pdf.download/
