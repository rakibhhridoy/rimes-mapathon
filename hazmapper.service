[Unit]
Description=Fermium Hazard Mapper (FastAPI web app, SQLite and vector tiles)
After=network.target

[Service]
Type=simple
# A dedicated account with no shell, so a public process never runs as root.
User=hazmapper
Group=hazmapper
WorkingDirectory=/var/www/hazmapper
ExecStart=/var/www/hazmapper/.venv/bin/uvicorn web.api:app --host 127.0.0.1 --port 2030 --workers 2 --no-server-header --proxy-headers
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# The app only reads: the database and tiles are built on the analysis
# machine and copied in, so nothing here writes to disk.
MemoryMax=1G
MemoryHigh=768M
CPUQuota=150%
TasksMax=256

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/www/hazmapper
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
